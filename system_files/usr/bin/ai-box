#!/usr/bin/env python3
"""Render and install a restricted, rootless llama.cpp Quadlet. Python stdlib only."""
import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import platform
import re
import secrets
import shutil
import subprocess
import sys
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise ValueError('HTTP redirects are forbidden for local API and model metadata requests')

IMAGE_RE = re.compile(r"docker\.io/kyuz0/amd-strix-halo-toolboxes@sha256:[0-9a-f]{64}\Z")
SAFE_PATH = re.compile(r"[A-Za-z0-9_./~-]+\Z")
KEYS = {"image", "model_dir", "model_file", "model_files", "render_device", "port", "context", "memory_gib", "reserve_gib"}
LEGACY_KEYS = (KEYS - {"model_files"}) | {"model_sha256"}
SPLIT_RE = re.compile(r"(.+)-(\d{5})-of-(\d{5})\.gguf\Z")
DEFAULT_CONFIG = Path.home() / ".config/ai-box/config.json"


def fail(message):
    raise ValueError(message)


def read_config(path):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                fail(f"Duplicate config key: {key}")
            result[key] = value
        return result
    value = json.loads(Path(path).read_text(), object_pairs_hook=unique)
    check_keys(value)
    return value


def check_keys(config):
    if not isinstance(config, dict) or set(config) not in (KEYS, LEGACY_KEYS):
        fail("Config must contain exactly: " + ", ".join(sorted(KEYS)) +
             "; legacy single-file configs may use model_sha256 instead of model_files")


def validated(config):
    check_keys(config)
    c = dict(config)
    if not isinstance(c['image'], str) or not IMAGE_RE.fullmatch(c['image']):
        fail("image must be the approved toolbox repository pinned by sha256; run pin first")
    for key in ('model_dir', 'model_file', 'render_device'):
        if not isinstance(c[key], str) or not SAFE_PATH.fullmatch(c[key]):
            fail(f"{key} must contain only letters, numbers, _, ., /, ~, or -")
    c['model_dir'] = str(Path(c['model_dir']).expanduser().resolve())
    if not SAFE_PATH.fullmatch(c['model_dir']):
        fail("Expanded model directory cannot contain spaces, percent signs, or unit metacharacters")
    dedicated = Path.home().resolve() / '.local/share/ai-box/models'
    if not Path(c['model_dir']).is_relative_to(dedicated):
        fail('model_dir must resolve inside ~/.local/share/ai-box/models; broad host mounts are forbidden')
    f = Path(c['model_file'])
    if (f.is_absolute() or '..' in f.parts or '~' in c['model_file'] or
            f.suffix != '.gguf' or f.as_posix() != c['model_file']):
        fail("model_file must be a canonical relative .gguf path under model_dir")
    split = SPLIT_RE.fullmatch(c['model_file'])
    if 'model_sha256' in c:
        if split:
            fail("Split GGUF requires model_files with a reviewed SHA-256 for every shard")
        c['model_files'] = {c['model_file']: c.pop('model_sha256')}
    expected = {c['model_file']}
    if split:
        prefix, index, count = split.groups()
        count = int(count)
        if index != '00001' or count < 2:
            fail("model_file must name shard 00001 of a set containing at least two shards")
        expected = {f'{prefix}-{i:05d}-of-{count:05d}.gguf' for i in range(1, count + 1)}
    manifest = c['model_files']
    if not isinstance(manifest, dict) or set(manifest) != expected:
        fail("model_files must list exactly the selected GGUF or its complete, consistently named shard set")
    for name, digest in manifest.items():
        if not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):
            fail(f"model_files[{name}] must be a reviewed publisher SHA-256")
    c['model_files'] = dict(manifest)
    if not re.fullmatch(r'/dev/dri/renderD[0-9]+', c['render_device']):
        fail("render_device must identify one /dev/dri/renderD* node")
    for key, low, high in [('port',1024,65535), ('context',512,131072), ('memory_gib',4,240), ('reserve_gib',4,128)]:
        if key == 'memory_gib' and c[key] == 'auto':
            continue
        if type(c[key]) is not int or not low <= c[key] <= high:
            fail(f"{key} must be an integer between {low} and {high}")
    if c['port'] == 8081:
        fail('port 8081 is reserved for Bifrost; choose another loopback backend port')
    return c


def model_path(c, name=None):
    root = Path(c['model_dir'])
    model = (root / (name or c['model_file'])).resolve()
    if not model.is_relative_to(root) or not model.is_file():
        fail("Model is absent or resolves outside model_dir")
    return model


def verify_model_files(c):
    # Resolve every path before hashing; no pull, key or unit write is allowed
    # until the entire reviewed set is present and matches its manifest.
    files = [(name, model_path(c, name)) for name in sorted(c['model_files'])]
    print(f'Verifying model checksums ({len(files)} file(s))...', file=sys.stderr)
    for name, path in files:
        with path.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        if digest != c['model_files'][name]:
            fail(f'Model checksum mismatch: {name}')


def resolve_memory_budget(c, report=None):
    if c['memory_gib'] != 'auto':
        return c
    report = doctor() if report is None else report
    if 'mem_total_gib' not in report:
        fail('Automatic memory budgeting requires Linux MemTotal; set an explicit integer budget for an offline plan')
    c = dict(c)
    c['memory_gib'] = int(report['mem_total_gib']) - c['reserve_gib']
    return validated(c)


def render(c, home=None):
    c = resolve_memory_budget(validated(c))
    home = Path(home or Path.home()).resolve()
    key = str(home / '.config/ai-box/api-key')
    if not SAFE_PATH.fullmatch(key):
        fail("Home path cannot contain spaces, percent signs, or unit metacharacters")
    high = c['memory_gib'] * 9 // 10
    return f'''# Generated by ai-box. Manage through Cockpit or render the reviewed configuration again.
[Unit]
Description=Strix Halo local inference API
Wants=ai-box-bifrost.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
Image={c['image']}
ContainerName=ai-box-llama
Pull=never
UserNS=keep-id
GroupAdd=keep-groups
PodmanArgs=--runtime=crun
AddDevice={c['render_device']}
Network=pasta:--no-map-gw,--map-guest-addr,none
PublishPort=127.0.0.1:{c['port']}:8080
Volume={c['model_dir']}:/models:ro,Z
Volume={key}:/run/secrets/ai-box-api-key:ro,Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PidsLimit=512
Environment=HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
Exec=/usr/bin/llama-server --model /models/{c['model_file']} --host 0.0.0.0 --port 8080 --ctx-size {c['context']} --parallel 1 --n-gpu-layers 999 --flash-attn on --load-mode none --api-key-file /run/secrets/ai-box-api-key --no-webui --no-slots

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
MemoryHigh={high}G
MemoryMax={c['memory_gib']}G
MemorySwapMax=0

[Install]
WantedBy=default.target
'''


def run(args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def doctor():
    report = {'platform': platform.system(), 'architecture': platform.machine()}
    if platform.system() != 'Linux':
        report.update(ready=False, reason='Deployment requires an x86_64 Linux Strix Halo host')
        return report
    mem = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        k, v = line.split(':', 1)
        mem[k] = int(v.strip().split()[0])
    cmdline = Path('/proc/cmdline').read_text().strip()
    enforce = Path('/sys/fs/selinux/enforce')
    nodes = list(Path('/dev/dri').glob('renderD*'))
    report.update(mem_total_gib=mem['MemTotal']/1024**2,
                  mem_available_gib=round(mem['MemAvailable']/1024**2,2),
                  cmdline=cmdline, selinux_enforcing=enforce.exists() and enforce.read_text().strip() == '1',
                  iommu_disabled=any(x in cmdline.split() for x in ('amd_iommu=off','iommu=off')),
                  render_devices=[{'path':str(p), 'accessible':os.access(p, os.R_OK|os.W_OK),
                                   'vendor': (Path('/sys/class/drm')/p.name/'device/vendor').read_text().strip()
                                   if (Path('/sys/class/drm')/p.name/'device/vendor').exists() else 'unknown'} for p in nodes],
                  rootless=os.geteuid() != 0,
                  tools={x: bool(shutil.which(x)) for x in ('podman','crun','pasta','systemctl')})
    for module, name in [('ttm','pages_limit'),('amdgpu','gttsize')]:
        path=Path(f'/sys/module/{module}/parameters/{name}')
        # Informational only: kernels may restrict these values to root.
        try:
            value = path.read_text().strip()
        except FileNotFoundError:
            value = 'not exposed'
        except PermissionError:
            value = 'permission denied (optional diagnostic)'
        except OSError as error:
            value = f'unavailable (optional diagnostic): {error.strerror or type(error).__name__}'
        report[f'{module}.{name}'] = value
    report['ready'] = (report['architecture'] == 'x86_64' and report['rootless'] and
                       report['selinux_enforcing'] and not report['iommu_disabled'] and
                       any(n['accessible'] and n['vendor'] == '0x1002' for n in report['render_devices']) and all(report['tools'].values()))
    report['qualification'] = 'Preflight only; does not prove gfx1151, DMA isolation, GPU operation, or capacity'
    return report


def install(config, start):
    c=validated(read_config(config))
    report=doctor()
    if not report['ready']:
        fail('Host preflight failed. Run ai-box doctor; see ../ucore-strix-halo-ai-docs/knowledge/operations/deploy.md in the paired checkouts')
    c=resolve_memory_budget(c, report)
    devices={n['path']:n for n in report['render_devices']}
    if c['render_device'] not in devices or not devices[c['render_device']]['accessible'] or devices[c['render_device']]['vendor'] != '0x1002':
        fail('Configured render device must be an accessible AMD device')
    if c['memory_gib'] + c['reserve_gib'] > report['mem_total_gib']:
        fail('memory_gib + reserve_gib exceeds Linux-visible physical memory')
    verify_model_files(c)
    # Pulling by digest guarantees the content identity, not the publisher identity.
    run(['podman','pull',c['image']])
    directory=Path.home()/'.config/ai-box'
    if directory.is_symlink():
        fail('Private config directory must not be a symlink')
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory.chmod(0o700)
    key=directory/'api-key'
    if key.is_symlink():
        fail('API key must not be a symlink')
    if not key.exists():
        descriptor=os.open(key, os.O_WRONLY|os.O_CREAT|os.O_EXCL, 0o600)
        with os.fdopen(descriptor,'w') as stream:
            stream.write(secrets.token_urlsafe(48)+'\n')
    key.chmod(0o600)
    if not re.fullmatch(r'[A-Za-z0-9_-]{32,256}', key.read_text().strip()):
        fail('API key must be one URL-safe token of at least 32 characters')
    # Check flags inside the exact image before writing the service definition.
    help_text=run(['podman','run','--rm','--network=none','--read-only','--cap-drop=all',
                   '--security-opt=no-new-privileges',c['image'],'/usr/bin/llama-server','--help'],
                  capture_output=True)
    help_text=help_text.stdout+help_text.stderr
    for flag in ('--load-mode','--flash-attn','--api-key-file','--no-webui','--no-slots'):
        if flag not in help_text:
            fail(f'Pinned runtime does not support {flag}; qualify another digest')
    target=Path.home()/'.config/containers/systemd/ai-box-llama.container'
    target.parent.mkdir(parents=True,exist_ok=True)
    if target.is_symlink():
        fail('Quadlet target must not be a symlink')
    content=render(c)
    # The image owns the Bifrost binary/unit; the serving account owns private
    # backend and gateway credentials. Never return these through Cockpit.
    spec=importlib.util.spec_from_file_location('ai_box_bifrost',
        Path(__file__).resolve().parents[1]/'share/ai-box/bifrost.py')
    gateway=importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gateway)
    gateway.install(c['port'])
    if target.exists() and target.read_text() != content:
        shutil.copy2(target,target.with_suffix('.container.previous'))
    target.write_text(content)
    run(['systemctl','--user','daemon-reload'])
    # Generated Quadlet services are activated by WantedBy, not systemctl enable.
    run(['systemctl','--user','cat','ai-box-llama.service'],stdout=subprocess.DEVNULL)
    if start:
        # An explicit reviewed reinstall may repair a failed service. Clear its
        # previous start-limit failure before requesting the new configuration.
        run(['systemctl','--user','reset-failed','ai-box-llama.service'])
        run(['systemctl','--user','restart','ai-box-llama.service'])
    print(f'Installed {target}; API key file: {key}. Run ai-box smoke after model loading.')


def pin(config, channel):
    if platform.system() != 'Linux' or os.geteuid() == 0:
        fail('Pin as the unprivileged service user on Linux')
    path=Path(config)
    if path.is_symlink():
        fail('Config must not be a symlink')
    c=read_config(path)
    repository='docker.io/kyuz0/amd-strix-halo-toolboxes'
    tag=f'{repository}:{channel}'
    run(['podman','pull',tag])
    info=json.loads(run(['podman','image','inspect',tag],capture_output=True).stdout)
    matches=[d for d in info[0].get('RepoDigests',[]) if IMAGE_RE.fullmatch(d)]
    if not matches:
        fail('Podman did not return a digest for the expected repository')
    c['image']=sorted(matches)[0]
    # Other fields may still be placeholders; install validates the entire config.
    path.write_text(json.dumps(c,indent=2)+'\n')
    print(f'Resolved {tag} to {c["image"]}. Review publisher provenance and qualify on hardware before promotion.')


def smoke(c):
    import urllib.request
    import urllib.error
    c=validated(c)
    # Local credentials must never be sent through environment-configured proxies.
    opener=urllib.request.build_opener(NoRedirect(), urllib.request.ProxyHandler({}))
    base=f'http://127.0.0.1:{c["port"]}'
    def request(path, data=None, key=None):
        headers={'Content-Type':'application/json'}
        if key:
            headers['Authorization']='Bearer '+key
        req=urllib.request.Request(base+path,data=json.dumps(data).encode() if data else None,headers=headers)
        with opener.open(req,timeout=180) as response:
            return json.load(response)
    if request('/health').get('status') != 'ok':
        fail('Model is not healthy')
    try:
        request('/v1/models')
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise
    else:
        fail('Protected API accepted an unauthenticated request')
    try:
        request('/v1/models',key='invalid-probe-key')
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise
    else:
        fail('Protected API accepted an incorrect key')
    key=(Path.home()/'.config/ai-box/api-key').read_text().strip()
    models=request('/v1/models',key=key)
    name=models['data'][0]['id']
    response=request('/v1/chat/completions',{'model':name,'messages':[{'role':'user','content':'Reply with OK.'}],'max_tokens':16},key)
    if not response.get('choices'):
        fail('Completion did not return choices')
    print('PASS: health, authentication rejection, model discovery, and completion')


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest='command', required=True)
    sub.add_parser('doctor')
    for command in ('plan','install','pin','smoke'):
        p=sub.add_parser(command)
        p.add_argument('--config',type=Path,default=DEFAULT_CONFIG)
        if command == 'install':
            p.add_argument('--start',action='store_true')
        if command == 'pin':
            p.add_argument('--channel',choices=['vulkan-radv'],default='vulkan-radv')
    args=parser.parse_args(argv)
    if args.command == 'doctor':
        report=doctor()
        print(json.dumps(report,indent=2))
        return 0 if report['ready'] else 1
    if args.command == 'plan':
        print(render(read_config(args.config)),end='')
    elif args.command == 'install':
        install(args.config,args.start)
    elif args.command == 'pin':
        pin(args.config,args.channel)
    elif args.command == 'smoke':
        smoke(read_config(args.config))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError, IndexError, subprocess.CalledProcessError) as error:
        print(f'ai-box: {error}',file=sys.stderr)
        sys.exit(1)
