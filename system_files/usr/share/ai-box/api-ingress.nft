# Replace only our table, atomically; never flush host/Tailscale firewall state.
add table inet ai_box_api
flush table inet ai_box_api
table inet ai_box_api {
    chain input {
        type filter hook input priority -10; policy accept;
        tcp dport 8081 ip saddr { 127.0.0.1, 10.0.0.0/8, 192.168.0.0/16, 100.64.0.0/10 } accept
        tcp dport 8081 drop
    }
}
