[Unit]
Description=Keep the local AI box text console awake
After=systemd-vconsole-setup.service
Before=getty.target
ConditionPathExists=/dev/tty0

[Service]
Type=oneshot
Environment=TERM=linux
# Open the console directly without taking control from a login session.
StandardInput=file:/dev/tty0
StandardOutput=file:/dev/tty0
StandardError=journal
ExecStart=/usr/bin/setterm --blank=0 --powerdown=0
RemainAfterExit=yes
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
