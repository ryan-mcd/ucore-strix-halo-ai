[Unit]
Description=Bifrost private-network inference gateway
Requires=ai-box-llama.service
After=ai-box-llama.service
PartOf=ai-box-llama.service
ConditionPathExists=%h/.config/ai-box/config.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/ai-box-bifrost serve
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
NoNewPrivileges=yes
UMask=0077
Environment=GOMEMLIMIT=450MiB
MemoryMax=512M
MemorySwapMax=0
TasksMax=128
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=default.target
